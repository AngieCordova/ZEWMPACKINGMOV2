<core:FragmentDefinition 
    xmlns="sap.m" 
    xmlns:core="sap.ui.core" 
    xmlns:form="sap.ui.layout.form" 
    xmlns:l="sap.ui.layout">
	<Dialog  
        title="Detalle: {mDetalle>/Lgber} - {mDetalle>/Zlado} / {mDetalle>/Znro}" 
        contentWidth="460px"
        class="sapUiNoContentPadding" 
        type="Message">
		<content class="sapUiNoContentPadding">

            <form:Form editable="false" class="sapUiNoContentPadding RemoverPaddingBottomFormMapaTunelesEnfriamiento">
                <form:layout>
                    <form:ResponsiveGridLayout
                        labelSpanXL="4"
                        labelSpanL="4"
                        labelSpanM="4"
                        labelSpanS="4"
                        adjustLabelSpan="false"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        emptySpanS="0"
                        columnsXL="1"
                        columnsL="1"
                        columnsM="1"
                        singleContainerFullSize="false" />
                </form:layout>
                <form:formContainers class="sapUiNoContentPadding">
                    <form:FormContainer>
                        <form:formElements>

                            <form:FormElement label="Número de Paleta">
                                <form:fields>
                           <!--     <Text text= "{path: 'mDetalle>/NroPallet',formatter: '.formatter.sinCerosIzq'}"/> -->
                                    <Text text="{mDetalle>/NroPallet}" />                                 
                                </form:fields>
                            </form:FormElement>

                            <form:FormElement label="Exportador">
                                <form:fields>
                                    <Text text="{mDetalle>/NombreCliente}" />
                                </form:fields>
                            </form:FormElement>
                            
                            <!-- PRODUCTO -->
                            <form:FormElement label="Descripción" id="element-producto_normal">
                                <form:fields>
                                    <Text text="{mDetalle>/DescProd}" />
                                </form:fields>
                            </form:FormElement>

                            <form:FormElement label="Cantidad de cajas" id="element-cantidad_cajas_sin_mix">
                                <form:fields>
                                    <Text text="{=  Number(${mDetalle>/CantCajas}) }" />
                                </form:fields>
                            </form:FormElement>

                        </form:formElements>
                    </form:FormContainer>
                </form:formContainers>
            </form:Form>


            <!-- PRODUCTO MIX -->
            <l:VerticalLayout class="sapUiContentPadding" width="100%" id="element-producto_mix" visible="false">
                <l:content>
                    <Table
                        items="{mListaCajas>/}">
                        <columns>
                            <Column vAlign="Middle" hAlign="Center">
                                <Text text="Descripción" />
                            </Column>
                            <Column vAlign="Middle" hAlign="Center">
                                <Text text="Cant. Cajas" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{mListaCajas>TipoEnvase}" />
                                    <Text
                                        text="{=  Number(${mListaCajas>CantCajas}) }" />
                                </cells>
                            </ColumnListItem>
                        </items>
                        <layoutData>
                            <l:GridData
                                span="XL12 L12 M12 S12" />
                        </layoutData>
                    </Table>
                </l:content>
            </l:VerticalLayout>

            <form:Form editable="false" class="sapUiNoContentPadding RemoverPaddingFormMapaTunelesEnfriamiento">
                <form:layout>
                    <form:ResponsiveGridLayout
                        labelSpanXL="4"
                        labelSpanL="4"
                        labelSpanM="4"
                        labelSpanS="4"
                        adjustLabelSpan="false"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        emptySpanS="0"
                        columnsXL="1"
                        columnsL="1"
                        columnsM="1"
                        singleContainerFullSize="false" />
                </form:layout>
                <form:formContainers class="sapUiNoContentPadding">
                    <form:FormContainer>
                        <form:formElements>
                            <form:FormElement label="T. Enfriamiento" class="TiempoEnfriamientoSemaforoClass">
                                <form:fields>
                                    <Text text="{= ${mDetalle>/TEnfriamiento} ? ${mDetalle>/TEnfriamiento} : '0' }" >
                                        <layoutData>
                                            <l:GridData
                                                span="XL6 L6 M6 S6" />
                                        </layoutData>
                                    </Text>
                                    <Text width="17px">
                                        <layoutData>
                                            <l:GridData
                                                span="XL2 L2 M2 S2" />
                                        </layoutData>
                                        <customData>
                                            <core:CustomData 
                                                key="semaforo-tunel-enfriamiento" 
                                                value="{
                                                    path: 'mDetalle>/TEnfriamiento',
                                                    formatter: '.formatter.colorTiempoEnfriamiento'
                                                }" 
                                                writeToDom="true" />
                                        </customData>
                                    </Text>
                                </form:fields>
                            </form:FormElement>

                        </form:formElements>
                    </form:FormContainer>
                </form:formContainers>
            </form:Form>
 
 
		</content>

		<beginButton>
			<Button icon="sap-icon://cancel" text="Cerrar" press="onCerrarFragmento"></Button>
		</beginButton>

        <!-- <endButton>
            <Button icon="sap-icon://save" text="Guardar" press="guardarPuerta" type="Emphasized"></Button>
        </endButton> -->
	</Dialog>
</core:FragmentDefinition>