<core:FragmentDefinition
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns="sap.m">
    <!-- <Panel>
		<headerToolbar>
			<OverflowToolbar>
				<Title text="Pallets preparados para remontar"/>
			</OverflowToolbar>
		</headerToolbar>
        <content> -->
            <Table items="{mListaPreparados>/}" id="table-lista_pallets_preparados_remontar">
                <!-- <headerToolbar>
                    <Toolbar>
                        <Button type="Emphasized" text="Pallets preparados para remontar"></Button>
                        <ToolbarSpacer/>
                        <SearchField placeholder="Filtrar Paletas" width="15rem" search="onFiltrarTabla"/>
                    </Toolbar>
                </headerToolbar> -->
                <columns>
                    <Column
                        width="6em"
                        hAlign="Center"
                        vAlign="Middle"
                        minScreenWidth="Phone"
                        demandPopin="true">
                        <Text text="Número de Paleta" />
                    </Column>

                    <Column
                        width="6em"
                        hAlign="Center"
                        vAlign="Middle"
                        minScreenWidth="Phone"
                        demandPopin="true">
                        <Text text="Producto"/>
                    </Column>

                    <Column
                        width="5em"
                        hAlign="Center"
                        vAlign="Middle"
                        minScreenWidth="1480px"
                        demandPopin="true">
                        <Text text="Id de Empresa Agrícola" />
                    </Column>

                    <Column
                        width="6em"
                        hAlign="Center"
                        vAlign="Middle"
                        minScreenWidth="1480px"
                        demandPopin="true">
                        <Text text="Empresa Agrícola" />
                    </Column>

                    <Column
                        width="10em"
                        hAlign="Center"
                        vAlign="Middle"
                        minScreenWidth="1480px"
                        demandPopin="true">
                        <Text text="Módulo" />
                    </Column>

                    <Column
                        width="10em"
                        hAlign="Center"
                        vAlign="Middle"
                        minScreenWidth="1480px"
                        demandPopin="true">
                        <Text text="Fecha de Empaque" />
                    </Column>

                    <Column
                        width="6em"
                        hAlign="Center"
                        vAlign="Middle"
                        minScreenWidth="Desktop"
                        demandPopin="true">
                        <Text text="Cajas en Paleta" />
                    </Column>

                    <Column
                        width="6em"
                        hAlign="Center"
                        vAlign="Middle"
                        minScreenWidth="Desktop"
                        demandPopin="true">
                        <Text text="Cajas Faltantes" />
                    </Column>

                    <Column
                        width="6em"
                        hAlign="Center"
                        vAlign="Middle"
                        minScreenWidth="Desktop"
                        demandPopin="true">
                        <Text text="Cantidad de cajas" />
                    </Column>
                    
                    <Column
                        width="6em"
                        hAlign="Center"
                        vAlign="Middle"
                        minScreenWidth="Desktop"
                        demandPopin="true">
                        <Text text="Max. Paleta" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{mListaPreparados>NRO_PALLET}"/>
                            <Text text="{mListaPreparados>PROD_DESCR}"/>
                            <Text text="{mListaPreparados>KUNNR}"/>
                            <Text text="{mListaPreparados>NAME_ORG1}"/>
                            <Text text="{mListaPreparados>MODULO}"/>
                            <Text text="{=
                                ${mListaPreparados>FECHA_EMPAQUE}.substring(6,8) + '.' +
                                ${mListaPreparados>FECHA_EMPAQUE}.substring(4,6) + '.' +
                                ${mListaPreparados>FECHA_EMPAQUE}.substring(0,4)
                            }"/>
                            <Text text="{mListaPreparados>CAJAS_PALLET}"/>
                            <Text text="{mListaPreparados>CJ_FALTANTES}"/>
                            <Text text="{mListaPreparados>CJ_FUSIONAR}"/>
                            <Text text="{mListaPreparados>MAX_PALLETS}"/>
                        </cells>
                    </ColumnListItem>								
                </items>
            </Table>
        <!-- </content>
    </Panel> -->
</core:FragmentDefinition>