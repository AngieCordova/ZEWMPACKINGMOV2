	<Dialog title="Tablero Programa" contentWidth="600px" type="Message" afterClose="onAfterCloseMasterDialog" afterOpen="onCreateMasterDialog">
		<content>
        
            <Button width="100%" icon="sap-icon://duplicate" text="Resumen Cajas Armadas por Semana" type="Emphasized" press="onShowResumenSemana"/>
