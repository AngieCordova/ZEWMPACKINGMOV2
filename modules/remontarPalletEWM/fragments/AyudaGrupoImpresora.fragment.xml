<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<SelectDialog
		growingThreshold="10"
		cancel="onCerrarFragmento('AyudaGrupoImpresora')"
		confirm="onAgregarValorMatchcodeImpresora"
		search="onFiltrarDatosMatchcodeImpresora"
		noDataText="SIN DATOS"
		title="SELECCIONE GRUPO IMPRESORAS"
		items="{mListaGrupoImpresora>/}" >
		<StandardListItem
			title="{mListaGrupoImpresora>ZZ_GRUPO}"
			description=""
			iconDensityAware="false"
			iconInset="false"
			type="Active" />
	</SelectDialog>
</core:FragmentDefinition>