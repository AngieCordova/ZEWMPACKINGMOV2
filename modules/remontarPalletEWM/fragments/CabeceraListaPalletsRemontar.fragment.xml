<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:l="sap.ui.layout"
	xmlns:f="sap.ui.layout.form"
	xmlns:core="sap.ui.core">
	<!-- <VBox class="sapUiSmallMargin"> -->
		<f:Form editable="false">
			<!-- <f:title>
				<core:Title text="Asignar Orden A Contenedor" />
			</f:title> -->
			<f:layout>
				<f:ResponsiveGridLayout
					labelSpanXL="12"
					labelSpanL="12"
					labelSpanM="12"
					labelSpanS="12"
					adjustLabelSpan="false"
					emptySpanXL="0"
					emptySpanL="0"
					emptySpanM="0"
					emptySpanS="0"
					columnsXL="3"
					columnsL="3"
					columnsM="3"
					singleContainerFullSize="false" />
			</f:layout>
			<f:formContainers>
				<f:FormContainer title="">
					<f:formElements>
						<!-- <f:FormElement label="Número de Orden"> -->
						<f:FormElement label="Número de Paleta">
							<f:fields>
								<Input enabled="false" value="{CABECERA>/NRO_PALLET}"/>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="Pedido">
							<f:fields>
								<Input enabled="false" value="{CABECERA>/PEDIDO}" />
							</f:fields>
						</f:FormElement>
					</f:formElements>
				</f:FormContainer>


				<f:FormContainer title="">
					<f:formElements>
						<f:FormElement label="Producto">
							<f:fields>
								<Input enabled="false" value="{CABECERA>/PROD_DESCR}"/>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="Cajas en paleta">
							<f:fields>
								<Input enabled="false" value="{CABECERA>/CAJAS_PALLET}" />
								<!-- <Input enabled="false" value="{ 
									parts: [
										{path: 'CABECERA>MAX_PALLETS'},
										{path: 'CABECERA>CJ_FALTANTES'}
									],
									formatter: '.formatter.calcularCantidadCajasEnPaleta' 
								}" /> -->
							</f:fields>
						</f:FormElement>
					</f:formElements>
				</f:FormContainer>


				<f:FormContainer title="">
					<f:formElements>
						<f:FormElement label="Fecha de producción">
							<f:fields>
								<Input enabled="false" value="{
											path: 'CABECERA>/FECHA_EMPAQUE',
								     		formatter: '.formatter.formatDate'
                            }"/>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="Cajas faltantes">
							<f:fields>
								<Input enabled="false" value="{CABECERA>/CJ_FALTANTES}"/>
							</f:fields>
						</f:FormElement>
					</f:formElements>
				</f:FormContainer>


				<f:FormContainer title="">
					<f:formElements>
						<f:FormElement label="Max. Paleta">
							<f:fields>
								<Input enabled="false" value="{CABECERA>/MAX_PALLETS}"/>
							</f:fields>
						</f:FormElement>
					</f:formElements>
				</f:FormContainer>
			</f:formContainers>
		</f:Form>
	<!-- </VBox> -->
</core:FragmentDefinition>