<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<SelectDialog
		growingThreshold="10"
		cancel="onCerrarFragmento('AyudaConsignatario')"
		confirm="onAgregarValorMatchcode(
			$event, 
			'AyudaConsignatario', 
			'scopeNPT', 
			{
				'NombreCons': '/ordenProceso/Consignatario',
				'ItemCons': '/ordenProceso/ConsignatarioID'
			}
		)"
		search="onFiltrarDatosMatchcode($event, ['NombreCons','ItemCons'])"
		noDataText="SIN DATOS"
		title="SELECCIONE CONSIGNATARIO"
		items="{/}" >
		<StandardListItem
			title="{NombreCons}"
			description="{ItemCons}"
			iconDensityAware="false"
			iconInset="false"
			type="Active" />
	</SelectDialog>
</core:FragmentDefinition>