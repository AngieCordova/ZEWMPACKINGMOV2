<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<SelectDialog
		growingThreshold="10"
		cancel="onCerrarFragmento('AyudaAlmacenDestino')"
		confirm="onAgregarValorMatchcode($event, 'AyudaAlmacenDestino', [{'path':'/almacen_destino','campo':''}])"
		search="onFiltrarDatosMatchcode($event, ['Lgort','Lgobe'])"
		noDataText="SIN DATOS"
		title="SELECCIONE ALMACEN DESTINO"
		items="{/}" >
		<StandardListItem
			title="{Lgort}"
			description="{Lgobe}"
			iconDensityAware="false"
			iconInset="false"
			type="Active" />
	</SelectDialog>
</core:FragmentDefinition>