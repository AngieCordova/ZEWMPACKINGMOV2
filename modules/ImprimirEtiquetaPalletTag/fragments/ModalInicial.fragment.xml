<core:FragmentDefinition 
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    height="100%">
	<Dialog 
        title="Imprimir Etiqueta Pallet Tag"
        contentHeight="150px" 
        contentWidth="600px" 
        type="Standard" 
        afterClose="onCerrarModal">
        
        <customHeader>
            <Bar>
                <contentLeft>
                </contentLeft>

                <contentMiddle>
                    <Text text="Imprimir Etiqueta Pallet Tag"/>
                </contentMiddle>

                <contentRight>
                    <Button type="Ghost" icon="sap-icon://decline" press="onCerrarModal"></Button>
                </contentRight>
            </Bar>
        </customHeader>
		
        <content>
            <form:Form width="100%">
                <!-- <form:title/> -->
                <form:layout>
                    <form:ResponsiveGridLayout
                        labelSpanXL="12"
                        labelSpanL="12"
                        labelSpanM="12"
                        labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        emptySpanS="0"
                        columnsXL="3"
                        columnsL="2"
                        columnsM="2"
                        breakpointM="300"
                        singleContainerFullSize="false" />
			    </form:layout>
                <form:formContainers>
                    <form:FormContainer>                        
                        <form:formElements>        
                            <form:FormElement label="N° Pallet">
                                <form:fields>
                                	<Input value="{mCampos>/Pallet}">
										<layoutData>
											<l:GridData span="XL12 L12 M12 S11" />
										</layoutData>
									</Input>
                                </form:fields>
                            </form:FormElement>
                        </form:formElements>
                    </form:FormContainer>

                    <form:FormContainer>
                        <form:formElements>

                           <!-- GRUPO DE IMPRESORAS -->
                            <form:FormElement label="Grupo de impresoras">
                                <form:fields>
                                    <Input value="{mCampos>/Impresora}">
                                    	<layoutData>
											<l:GridData span="XL10 L10 M10 S10" />
										</layoutData>
                                    </Input>
                                    <Button press="onAbrirAyudaBusquedaGrupoImpresora" type="Emphasized" icon="sap-icon://print" width="18%">
                                        <layoutData>
											<l:GridData span="XL2 L2 M2 S2" />
                                        </layoutData>
                                    </Button>
                                </form:fields>
                            </form:FormElement>
                                           
                        </form:formElements>
                        <form:title/>
                    </form:FormContainer>
                </form:formContainers>
            </form:Form>
        </content>
        
		<beginButton>
			<Button type="Ghost" icon="sap-icon://save" text="Imprimir" press="onGuardar"></Button>
		</beginButton>
		<endButton>
            <Button type="Ghost" icon="sap-icon://cancel" text="Cerrar" press="onCerrarModal"></Button>
		</endButton>
	</Dialog>
</core:FragmentDefinition>