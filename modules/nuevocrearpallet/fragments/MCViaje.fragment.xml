<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<SelectDialog
		growingThreshold="10"
		cancel="onCerrarFragmento('MCViaje')"
		confirm="onSelectMCTratamientoFrio"
		search="onFilterMCTratamientoFrio($event, ['VIAJE','PEDIDO'])"
		noDataText="SIN DATOS"
		title="Lista de Viajes"
		items="{scope>/MCTratamientoFrio/}" >
		<StandardListItem
			title="{scope>VIAJE}-{scope>PEDIDO}"
			description=""
			iconDensityAware="false"
			iconInset="false"
			type="Active" />
	</SelectDialog>
</core:FragmentDefinition>