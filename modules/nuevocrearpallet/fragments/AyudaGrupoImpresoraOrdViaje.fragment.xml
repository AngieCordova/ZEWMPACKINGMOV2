<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<SelectDialog
		id="Lname-"
		growingThreshold="10"
		cancel="onCerrarFragmento('AyudaGrupoImpresoraOrdViaje')"
		confirm="onAddValMCImpresoraOrdViaje"
		search="onFiltrarDatosMatchcode"
		noDataText="SIN DATOS"
		title="SELECCIONE GRUPO IMPRESORAS"
		items="{mListaAyudaImpresoraSet>/}" >
		<StandardListItem
			title="{mListaAyudaImpresoraSet>Lname}"
			description=""
			iconDensityAware="false"
			iconInset="false"
			type="Active" />
	</SelectDialog>
</core:FragmentDefinition>