<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form" xmlns:l="sap.ui.layout">
	<Dialog busy="{mBusy>/iniciarPost}" title="Pre registrar PALET" contentWidth="680px" type="Message" afterClose="onCerrarFragmento('PreRegistrarPalet')">
		<content>
		
            <form:Form width="100%" editable="true" visible="true" class="inputPaddingTopNull" id="form_uno_nuevo_tratar_paleta">
                <!-- <form:title/> -->
                <form:layout>
                    <form:ResponsiveGridLayout
                        labelSpanXL="12"
                        labelSpanL="12"
                        labelSpanM="12"
                        labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        emptySpanS="0"
                        columnsXL="3"
                        columnsL="2"
                        columnsM="2"
                        singleContainerFullSize="false" />
			    </form:layout>
                <form:formContainers>
                    <form:FormContainer>                        
                        <form:formElements>        

                        	<!--FECHA DE COSECHA-->
                            <form:FormElement label="Fecha de cosecha">
                                <form:fields>
                                	<Input value="{mPreRegistro>/FCH_COSECHA}" editable="false">
										<layoutData>
											<l:GridData span="XL12 L12 M12 S11" />
										</layoutData>
									</Input>
                                </form:fields>
                            </form:FormElement>
                            
                        	<!--EMPRESA AGRICOLA-->
                            <form:FormElement label="Empresa Agrícola" class="inputPaddingTopNull">
                                <form:fields>
                                	<Input value="{mPreRegistro>/PARTNER_NAME}" editable="false">
										<layoutData>
											<l:GridData span="XL12 L12 M12 S11" />
										</layoutData>
									</Input>
                                </form:fields>
                            </form:FormElement>
                            
                        	<!--CONSIGNATARIO-->
                            <form:FormElement label="Consignatario" class="inputPaddingTopNull">
                                <form:fields>
                                	<Input value="{mPreRegistro>/DESTINO_CLIENTE}" name="{mPreRegistro>/CONSIGNATARIO}" editable="false">
										<layoutData>
											<l:GridData span="XL10 L10 M10 S10" />
										</layoutData>
									</Input>
                                    <Button press="onAbrirAyudaBusquedaConsignatario" type="Emphasized" icon="sap-icon://employee-lookup" width="18%">
                                        <layoutData>
											<l:GridData span="XL2 L2 M2 S2" />
                                        </layoutData>
                                    </Button>
                                </form:fields>
                            </form:FormElement>
                        	
                        </form:formElements>
                    </form:FormContainer>

                    <form:FormContainer>
                        <form:formElements>                           
                           <!-- GRUPO DE IMPRESORAS -->
                            <form:FormElement label="Grupo de impresoras">
                                <form:fields>
                                    <Input value="{mPreRegistro>/GRUPO_IMPRESORAS}" editable="false">
                                    	<layoutData>
											<l:GridData span="XL10 L10 M10 S10" />
										</layoutData>
                                    </Input>
                                    <Button enabled="{= ${mBusy>/iniciarPost} ? false : true}" press="onAbrirAyudaBusquedaGrupoImpresora" type="Emphasized" icon="sap-icon://print" width="18%">
                                        <layoutData>
											<l:GridData span="XL2 L2 M2 S2" />
                                        </layoutData>
                                    </Button>
                                </form:fields>
                            </form:FormElement>

                            <!-- MODULO -->
                            <form:FormElement label="Módulo" class="inputPaddingTopNull">
                                <form:fields>
                                    <Input value="{mPreRegistro>/MODULO} - {mPreRegistro>/MODULO_DESCR}" editable="false">
                                    	<layoutData>
											<l:GridData span="XL12 L12 M12 S12" />
										</layoutData>
                                    </Input>
                                </form:fields>
                            </form:FormElement>

                            <!-- PRODUCTO -->
                            <form:FormElement label="Producto" class="inputPaddingTopNull">
                                <form:fields>
                                    <Input value="{mPreRegistro>/PRODUCTO}" name="{mPreRegistro>/DESCRIP_PRODUCTO}" editable="false">
                                    	<layoutData>
											<l:GridData span="XL10 L10 M10 S10" />
										</layoutData>
                                    </Input>
                                    <Button press="onAbrirAyudaBusquedaProducto" enabled="{= ${mPreRegistro>/CONSIGNATARIO} ? true : false}" type="Emphasized" icon="sap-icon://product" width="18%">
                                        <layoutData>
											<l:GridData span="XL2 L2 M2 S2" />
                                        </layoutData>
                                    </Button>
                                </form:fields>
                            </form:FormElement>                        
                        </form:formElements>
                        <form:title/>
                    </form:FormContainer>
                </form:formContainers>
            </form:Form>

            <!-- LOTE -->
            <!-- <form:Form width="100%" editable="true" visible="true" class="inputPaddingTopNull">
                <form:title/>
                <form:layout>
                    <form:ResponsiveGridLayout
                        labelSpanXL="12"
                        labelSpanL="12"
                        labelSpanM="12"
                        labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        emptySpanS="0"
                        columnsXL="1"
                        columnsL="1"
                        columnsM="1"
                        singleContainerFullSize="false" />
			    </form:layout>
                <form:formContainers>
                    <form:FormContainer>                        
                        <form:formElements>
                            <form:FormElement label="Lote">
                                <form:fields>
                                	<Input editable="false" value="{mPreRegistro>/LOTE}">
										<layoutData>
											<l:GridData span="XL12 L12 M12 S11" />
										</layoutData>
									</Input>
                                </form:fields>
                            </form:FormElement>                 
                        </form:formElements>
                    </form:FormContainer>
                </form:formContainers>
            </form:Form> -->

            
            <!-- DESCRIPCION DEL PRODUCTO -->
            <form:Form width="100%" editable="true" visible="true" class="inputPaddingTopNull" id="form_dos_nuevo_tratar_paleta">
                <form:title/>
                <form:layout>
                    <form:ResponsiveGridLayout
                        labelSpanXL="12"
                        labelSpanL="12"
                        labelSpanM="12"
                        labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        emptySpanS="0"
                        columnsXL="1"
                        columnsL="1"
                        columnsM="1"
                        singleContainerFullSize="false" />
			    </form:layout>
                <form:formContainers>
                    <form:FormContainer>                        
                        <form:formElements>
                        	<!--DESCRIPCION DEL PRODUCTO-->
                            <form:FormElement label="Descripción del producto">
                                <form:fields>
                                	<Input editable="false" value="{mPreRegistro>/DESCRIP_PRODUCTO}">
										<layoutData>
											<l:GridData span="XL12 L12 M12 S11" />
										</layoutData>
									</Input>
                                </form:fields>
                            </form:FormElement>                 
                        </form:formElements>
                    </form:FormContainer>
                </form:formContainers>
            </form:Form>

            <form:Form width="100%" editable="true" visible="true" class="inputPaddingTopNull" id="form_tres_nuevo_tratar_paleta">
                <form:title/>
                <form:layout>
                    <form:ResponsiveGridLayout
                        labelSpanXL="12"
                        labelSpanL="12"
                        labelSpanM="12"
                        labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        emptySpanS="0"
                        columnsXL="3"
                        columnsL="2"
                        columnsM="2"
                        singleContainerFullSize="false" />
			    </form:layout>
                <form:formContainers>
                    <form:FormContainer>
                        
                        <form:formElements>                                    
                        	<!--FECHA DE RECEPCION-->
                            <form:FormElement label="Fecha de recepción">
                                <form:fields>
                                	<Input value="{mPreRegistro>/FCH_RECEPCION}" editable="false">
										<layoutData>
											<l:GridData span="XL12 L12 M12 S11" />
										</layoutData>
									</Input>
                                </form:fields>
                            </form:FormElement>                            
                            
                        	<!--LINEA-->
                            <form:FormElement label="Línea" class="inputPaddingTopNull">
                                <form:fields>
                                	<Input editable="false" value="{mPreRegistro>/LINEA}">
										<layoutData>
											<l:GridData span="XL6 L3 M3 S12" />
										</layoutData>
									</Input>
                                    
                                	<Input editable="false" value="{mPreRegistro>/MAXPALETA}" description="MAX. PALETA">
										<layoutData>
											<l:GridData span="XL6 L9 M9 S12" />
										</layoutData>
									</Input>
                                </form:fields>
                            </form:FormElement>                       	
                        	  
                        </form:formElements>
                    </form:FormContainer>

                    <form:FormContainer>
                        <form:formElements>  
                            <!-- GUIA -->
                            <form:FormElement label="Guía" class="inputPaddingTopNull">
                                <form:fields>
                                    <Input id="input-guia_preregistro" value="{mPreRegistro>/GUIA}-{mPreRegistro>/LINEA}" editable="false">
                                    	<layoutData>
											<l:GridData span="XL10 L10 M10 S10" />
										</layoutData>
                                    </Input>
                                    <Button enabled="{= ${mBusy>/iniciarPost} ? false : true}" press="onAbrirAyudaBusquedaGuia" type="Emphasized" icon="sap-icon://subway-train" width="18%">
                                        <layoutData>
											<l:GridData span="XL2 L2 M2 S2" />
                                        </layoutData>
                                    </Button>
                                </form:fields>
                            </form:FormElement>   
                            
                            <!-- CANTIDAD -->
                            <form:FormElement label="Cantidad" class="inputPaddingTopNull">
                                <form:fields>
                                    <Input
                                        id="input-preregistrarpallet-cantidad"
                                        maxLength="3"
                                        liveChange="noSuperaMaxPallet">
                                        <!-- value="{mPreRegistro>/CANTIDAD}" -->
                                    	<layoutData>
											<l:GridData span="XL12 L12 M12 S12" />
										</layoutData>
                                    </Input>
                                </form:fields>
                            </form:FormElement>                      
                        </form:formElements>
                        <form:title/>
                    </form:FormContainer>
                </form:formContainers>
            </form:Form>

            
            <form:Form width="100%" editable="true" visible="true" class="inputPaddingTopNull" id="form_cuatro_nuevo_tratar_paleta">
                <form:title/>
                <form:layout>
                    <form:ResponsiveGridLayout
                        labelSpanXL="12"
                        labelSpanL="12"
                        labelSpanM="12"
                        labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        emptySpanS="0"
                        columnsXL="1"
                        columnsL="1"
                        columnsM="1"
                        singleContainerFullSize="false" />
			    </form:layout>
                <form:formContainers>
                    <form:FormContainer>                        
                        <form:formElements>
                        	<!--COMENTARIO-->
                            <form:FormElement label="Comentario" visible="false">
                                <form:fields>
                                	<Input maxLength="40" value="{mPreRegistro>/COMENTARIO}">
										<layoutData>
											<l:GridData span="XL12 L12 M12 S11" />
										</layoutData>
									</Input>
                                </form:fields>
                            </form:FormElement>                 
                        </form:formElements>
                    </form:FormContainer>
                </form:formContainers>
            </form:Form>
		</content>

		<beginButton>
			<Button enabled="{= ${mBusy>/iniciarPost} ? false : true}" type="Ghost" icon="sap-icon://cancel" text="CANCELAR" press="onCerrarFragmento('PreRegistrarPalet')"></Button>
		</beginButton>
		<endButton>
			<Button enabled="{= ${mBusy>/iniciarPost} ? false : true}" type="Emphasized" icon="sap-icon://save" text="GUARDAR" press="onGuardarPreRegistro"></Button>
		</endButton>
	</Dialog>
</core:FragmentDefinition>