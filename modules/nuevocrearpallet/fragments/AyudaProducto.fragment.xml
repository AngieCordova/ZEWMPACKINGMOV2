<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<SelectDialog
		id="Producto-Descripcion"
		growingThreshold="10"
		cancel="onCerrarFragmento('AyudaProducto')"
		confirm="onAgregarValorMatchcode"
		search="onFiltrarDatosMatchcode"
		noDataText="SIN DATOS"
		title="SELECCIONE PRODUCTO"
		items="{ZEWM_0001>/ProductosSet}" >
		<StandardListItem
			title="{ZEWM_0001>Producto}"
			description="{ZEWM_0001>Descripcion}"
			iconDensityAware="false"
			iconInset="false"
			type="Active" />
	</SelectDialog>
</core:FragmentDefinition>