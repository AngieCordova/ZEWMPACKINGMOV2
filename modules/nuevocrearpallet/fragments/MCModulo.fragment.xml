<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<SelectDialog
		growingThreshold="10"
		cancel="onCerrarFragmento('MCModulo')"
		confirm="onSelectMCTratamientoFrio"
		search="onFilterMCTratamientoFrio($event, ['EQV_FM','DESCOR'])"
		noDataText="SIN DATOS"
		title="Lista de Módulos"
		items="{scope>/MCTratamientoFrio/}" >
		<StandardListItem
			title="{scope>EQV_FM}-{scope>DESCOR}"
			description=""
			iconDensityAware="false"
			iconInset="false"
			type="Active" />
	</SelectDialog>
</core:FragmentDefinition>