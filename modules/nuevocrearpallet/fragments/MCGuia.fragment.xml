<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<SelectDialog
		growingThreshold="10"
		cancel="onCerrarFragmento('MCGuia')"
		confirm="onSelectMCTratamientoFrio"
		search="onFilterMCTratamientoFrio($event, ['GUIA','FECCOS','LINEA'])"
		noDataText="SIN DATOS"
		title="Lista de Guías"
		items="{scope>/MCTratamientoFrio/}" >
		<StandardListItem
			title="{scope>GUIA}"
			description="{scope>FECCOS}"
			iconDensityAware="false"
			iconInset="false"
			type="Active" />
	</SelectDialog>
</core:FragmentDefinition>