<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<SelectDialog
		id="GUIA-LINEA"
		growingThreshold="10"
		cancel="onCerrarFragmento('AyudaGuia')"
		confirm="onAgregarValorMatchcode($event, 'bAyudaGuiaTrue')"
		search="onFiltrarDatosMatchcode"
		noDataText="SIN DATOS"
		title="SELECCIONE GUÍA"
		items="{AyudaGuia>/}" >
		<StandardListItem
			title="{AyudaGuia>GUIA}-{AyudaGuia>LINEA}"
			description="{AyudaGuia>LINEA}"
			iconDensityAware="false"
			iconInset="false"
			type="Active" />
	</SelectDialog>
</core:FragmentDefinition>