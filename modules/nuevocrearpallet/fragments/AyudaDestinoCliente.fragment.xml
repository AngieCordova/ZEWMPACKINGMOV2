<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<SelectDialog
		id="NOMBRE-ITEM"
		growingThreshold="10"
		cancel="onCerrarFragmento('AyudaDestinoCliente')"
		confirm="onAgregarValorMatchcode"
		search="onFiltrarDatosMatchcode"
		noDataText="SIN DATOS"
		title="SELECCIONE CONSIGNATARIO"
		items="{mListaAyudaConsignatario>/}" >
		<StandardListItem
			title="{mListaAyudaConsignatario>NOMBRE}"
			description="{mListaAyudaConsignatario>ITEM}"
			iconDensityAware="false"
			iconInset="false"
			type="Active" />
	</SelectDialog>
</core:FragmentDefinition>