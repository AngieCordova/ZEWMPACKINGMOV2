<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.ui.layout.form" xmlns:l="sap.ui.layout"
  xmlns:u="sap.ui.table" xmlns:t="sap.tnt" >
    <Page id="IdBinsEmp" title="HU's a línea de empaque" showNavButton="true" class="sapUiStdPage" navButtonPress="onPressInicion">
      <content>
        <Table id="idBinsTable" items="{ZV>/ITAB}" inset="false">
          <headerToolbar>
            <Toolbar>
              <Title text="HU's a línea de empaque" titleStyle="H3"/>
              <ToolbarSpacer/>
              <Button type="Emphasized" text="Estado Ant." press="onPressActualizarHULEANT" icon="sap-icon://close-command-field"/>
              <Button type="Emphasized" text="Estado Sgte." press="onPressActualizarHULEPOS" icon="sap-icon://open-command-field"/>
              <SearchField placeholder="Filtrar bins" value="{ui>/filterValue}" search="handleFilterBins" width="15rem"/>
							<Button icon="sap-icon://synchronize" press="onRefreshHUsaLineaEmpaque" />
            </Toolbar>
          </headerToolbar>
          <columns>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="4rem">
              <Text text="Selec."/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="9rem">
              <Text text="Guía"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="11rem">
              <Text text="Empresa Agrícola"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="5rem">
              <Text text="Módulo"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="5rem">
              <Text text="Variedad"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="4rem">
              <Text text="Bins"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="4rem">
              <Text text="Jabas"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="4rem">
              <Text text="Pallets"/>
            </Column>
          </columns>
          <items>
            <ColumnListItem type="Navigation" press="oDialogConfirm">
              <cells>
                <CheckBox selected="{ZV>ACTUALIZARHULE}"/>
                <Text text="{ZV>GUIA}"/>
                <Text text="{ZV>TXT_EMP}"/>
                <Text text="{ZV>MODULO}-{ZV>DESCOR}"/>
                <Text text="{ZV>VARIEDAD}-{ZV>DESC_VAR}"/>
                <Text text="{ZV>BINS}"/>
                <Text text="{ZV>JABAS}"/>
                <Text text="{ZV>PALLETS}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </content>
    </Page>
</core:FragmentDefinition>
