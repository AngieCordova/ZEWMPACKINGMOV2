<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.ui.layout.form" xmlns:l="sap.ui.layout"
  xmlns:u="sap.ui.table" xmlns:t="sap.tnt">
    <Page id="IdIngCamion" title="Confirmar camión" showNavButton="true" class="sapUiStdPage" navButtonPress="onPressInicion">
      <content>
        <Table id="idProductsTable" items="{/ITAB}" inset="false">
          <headerToolbar>
            <Toolbar>
              <Title text="Camión de campo" titleStyle="H3"/>
              <ToolbarSpacer/>
              <SearchField placeholder="Filtrar camión" value="{ui>/filterValue}" search="handleFilterCamion" width="15rem"/>
							<Button icon="sap-icon://synchronize" press="onRefreshIngCamion" />
            </Toolbar>
          </headerToolbar>
          <columns>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Entrega"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Guía"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Código de empresa"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Empresa Agrícola"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Estatus"/>
            </Column>
          </columns>
          <items>
            <ColumnListItem type="Navigation" press="oDialogDetail">
              <cells>
                <Text text="{VBELN}"/>
                <Text text="{GUIA}"/>
                <Text text="{PARTNER}"/>
                <Text text="{TXT_EMP}"/>
                <Label text="{TXT_STA}" design="Bold"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </content>
    </Page>
</core:FragmentDefinition>