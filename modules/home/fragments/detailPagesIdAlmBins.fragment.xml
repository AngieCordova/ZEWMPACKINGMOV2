<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.ui.layout.form" xmlns:l="sap.ui.layout"
  xmlns:u="sap.ui.table" xmlns:t="sap.tnt">
    <Page id="IdAlmBins" title="Stage Módulo" showNavButton="true" class="sapUiStdPage" navButtonPress="onPressInicion">
      <content>
        <Table id="idGuiaTable" items="{TP>/ITAB}" inset="false">
          <headerToolbar>
            <Toolbar>
              <Title text="Stage Módulo" titleStyle="H3"/>
              <ToolbarSpacer/>
              <Button type="Emphasized" text="Estado Sgte." press="onPressActualizarSTMPOS" icon="sap-icon://open-command-field"/>
              <SearchField placeholder="Filtrar stage" value="{ui>/filterValue}" search="handleFilterStage" width="15rem"/>
            </Toolbar>
          </headerToolbar>
          <columns>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="4rem">
              <Text text="Selec."/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="9rem">
              <Text text="Guía"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="6rem">
              <Text text="Entrega"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="8rem">
              <Text text="Empresa Agrícola"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Módulo"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Variedad"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="4rem">
              <Text text="Bins"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="4rem">
              <Text text="Jabas"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="4rem">
              <Text text="Pallets"/>
            </Column>
          </columns>
          <items>
            <ColumnListItem type="Navigation" press="oDialogAlmacenar">
              <cells>
                <CheckBox selected="{TP>ACTUALIZARSTM}"/>
                <Text text="{TP>GUIA}"/>
                <Text text="{TP>VBELN}"/>
                <Text text="{TP>TXT_EMP}"/>
                <Text text="{TP>MODULO}-{TP>DESCOR}"/>
                <Text text="{TP>VARIEDAD}-{TP>DESC_VAR}"/>
                <Text text="{TP>BINS}"/>
                <Text text="{TP>JABAS}"/>
                <Text text="{TP>PALLETS}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </content>
    </Page>
</core:FragmentDefinition>
