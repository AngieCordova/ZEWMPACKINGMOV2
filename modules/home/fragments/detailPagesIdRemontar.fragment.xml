<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.ui.layout.form" xmlns:l="sap.ui.layout"
  xmlns:u="sap.ui.table" xmlns:t="sap.tnt">
    <Page id="IdRemontar" title="Paletas Incompletas de producto terminado" showNavButton="true" class="sapUiStdPage"
      navButtonPress="onPressInicion">
      <content>
        <Table id="idRemotTable" items="{RM>/ITAB}" inset="false">
          <headerToolbar>
            <Toolbar>
              <Title text="Paletas Incompletas de producto terminado" titleStyle="H3"/>
              <ToolbarSpacer/>
              <SearchField placeholder="Filtrar Paletas" value="{ui>/filterValue}" search="handleFilterRemontar" width="15rem"/>
            </Toolbar>
          </headerToolbar>
          <columns>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="N° de Paleta"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Producto"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Pedido"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Cajas en Paleta"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Max. Paleta"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Cajas Faltantes"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Fecha de Empaque"/>
            </Column>
          </columns>
          <items>
            <ColumnListItem type="Navigation" press="oDialogRemontar">
              <cells>
                <Text text="{RM>EXIDV2}"/>
                <Text text="{RM>MATNR} - {RM>MAKTX}"/>
                <Text text="{RM>SONUM}"/>
                <Text text="{RM>CAJPAL}"/>
                <Text text="{RM>MAXPAL}"/>
                <Text text="{RM>FALPAL}"/>
                <Text text="{RM>FECEMP}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </content>
    </Page>
</core:FragmentDefinition>