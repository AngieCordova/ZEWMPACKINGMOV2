<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.ui.layout.form" xmlns:l="sap.ui.layout"
  xmlns:u="sap.ui.table" xmlns:t="sap.tnt">
    <Page id="IdCrearPalet" title="Crear pallets de producto terminado" showNavButton="true" class="sapUiStdPage"
      navButtonPress="onPressInicion">
      <content>
        <Table id="idPaletTable" items="{CP>/ITAB}" inset="false">
          <headerToolbar>
            <Toolbar>
              <Title text="Crear pallets de producto terminado" titleStyle="H3"/>
              <Button type="Emphasized" text="Tratamiento Frío" press="onPressFrio" icon="sap-icon://database"/>
              <ToolbarSpacer/>
              <Button type="Emphasized" text="Re-Habilitar" press="onPressReHabilitar" icon="sap-icon://response"/>
              <ToolbarSpacer/>
              <Button type="Emphasized" text="Quitar" press="onPressDelete" icon="sap-icon://delete"/>
              <SearchField placeholder="Filtrar Paletas" value="{ui>/filterValue}" search="handleFilterCrear" width="15rem"/>
							<Button icon="sap-icon://synchronize" press="onRefreshPaletCrear" />
            </Toolbar>
          </headerToolbar>
          <columns>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" vAlign="Middle">
              <Text text="Seleccionar"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" vAlign="Middle">
              <Text text="Fecha de recepción"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" vAlign="Middle">
              <Text text="Empresa Agrícola"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" vAlign="Middle">
              <Text text="Módulo"/>
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" vAlign="Middle">
              <Text text="Estatus"/>
            </Column>
          </columns>
          <items>
            <ColumnListItem type="Navigation" press="oDialogDetail2">
              <cells>
                <CheckBox selected="{CP>ELIMINAR}"/>
                <Text text="{CP>FEC_REC}"/>
                <Text text="{CP>TXT_EMP}"/>
                <Text text="{CP>MODULO}-{CP>DESCOR}"/>
                <Label text="{CP>TXT_STA}" design="Bold"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </content>
    </Page>
</core:FragmentDefinition>