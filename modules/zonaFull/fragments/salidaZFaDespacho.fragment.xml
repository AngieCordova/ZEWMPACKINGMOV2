
<core:FragmentDefinition xmlns:mvc="sap.ui.core.mvc" 
                         xmlns:tb="sap.ui.table"
                         xmlns="sap.m" 
                         xmlns:core="sap.ui.core" 
                         xmlns:form="sap.ui.layout.form" 
                         xmlns:tnt="sap.tnt" 
                         xmlns:l="sap.ui.layout"
                         xmlns:tab="sap.ui.table">

 

    <Dialog title="APP Zona Full" 
            contentWidth="70%" 
            type="Message" 
            afterClose="onAfterCloseDialog('salidaZFaDespacho')"
             >
        <content>
         <Table 
                id="idContenedoresSalida"                
                items="{RepIngresoSalidaZF>/results}" 
                inset="false" 
                sticky="HeaderToolbar,InfoToolbar,ColumnHeaders" >
            <headerToolbar>
              <Toolbar>
                <Title text="Salida Desde ZF a Despacho" titleStyle="H3"/>
                <ToolbarSpacer/>
                <SearchField placeholder="Buscar" width="15rem" search="onFiltrarTabla"/>
                <Button icon="sap-icon://refresh" type="Transparent" press="onLoadContenedores('2')"/>
              </Toolbar>
            </headerToolbar>
            <columns>
             <!-- COLUMNA CHECKBOX -->
              <Column hAlign="Center" vAlign="Middle" width="6rem">
                <Text text="Item"/>
              </Column>   
              <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
                <Text text="Fecha Carga"/>
              </Column>
              <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
                <Text text="Booking"/>
              </Column>
              <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
                <Text text="Contenedor"/>
              </Column>
              <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
                <Text text="Orden"/>
              </Column>
              <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
                <Text text="Viaje"/>
              </Column>
              <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
                <Text text="Entrega"/>                 
              </Column>                  
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <CheckBox select="onCheckInRowSalDesp" 
                            selected="{RepIngresoSalidaZF>check}"
                            text="{RepIngresoSalidaZF>ITEM}" />                     
                  <Text text="{parts: [ {path: 'RepIngresoSalidaZF>FECHA_CARGA_SAP'} ], formatter: '.formatter.formatDate'}"/>                       
                  <Text text="{RepIngresoSalidaZF>ZZ_CODRSERVA}"/>
                  <Text text="{RepIngresoSalidaZF>ZZ_CONTENEDOR}"/>
                  <Text text="{RepIngresoSalidaZF>ZZ_NUMORDEN}"/>
                  <Text text="{RepIngresoSalidaZF>ZZ_VIAJE}"/>  
                  <Text text="{RepIngresoSalidaZF>ENTREGA_SAP}"/>                   
                <!-- <Text text="{path: 'RepIngresoSalidaZF>/ENTREGA_SAP',formatter: '.formatter.sinCerosIzq'}"/> --> 
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </content>

        <!--
         para boton
         enabled="{= ${mBusy>/iniciarPost} ? false : true}" 
          -->
        
        <beginButton>          
          <Button icon="sap-icon://save" text="Indicar Fecha" enabled="{scopeZF>/activeGuardar}" press="onSaveSalidaZFDespacho()"></Button>      
        </beginButton>

        <endButton>          
          <Button icon="sap-icon://cancel" text="Cerrar" press="onCloseDialog('salidaZFaDespacho')"></Button>      
        </endButton>

    </Dialog>
</core:FragmentDefinition>