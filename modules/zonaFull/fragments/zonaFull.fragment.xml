  <Dialog title="Zona Full" contentWidth="600px" type="Message" afterClose="onAfterCloseMasterDialog" afterOpen="onCreateMasterDialog">
    <content>
        
            <Button width="100%" icon="sap-icon://duplicate" text="Dar Ingreso o Reubicar en ZF" type="Emphasized" press="onShowVisualizarIngresoSalZF"/>
