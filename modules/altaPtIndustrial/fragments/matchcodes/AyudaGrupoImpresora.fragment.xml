		cancel="onCerrarFragmento('AyudaGrupoImpresora')"
		confirm="onAgregarValorMatchcodeGrupoImpresora"
		search="onFiltrarDatosMatchcodeGrupoImpresora"
		noDataText="SIN DATOS"
		title="IMPRESORA"
	 	items="{mAyudaImpresoras>/}" > 	     
		<StandardListItem
			title="{mAyudaImpresoras>IdImpresora}"
			description="{mAyudaImpresoras>IdImpresora}"
			iconDensityAware="false"
			iconInset="false"
			type="Active" />
