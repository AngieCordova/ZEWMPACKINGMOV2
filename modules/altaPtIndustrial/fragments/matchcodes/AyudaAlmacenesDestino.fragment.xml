<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<SelectDialog
		title="SELECCIONE ALMACEN DESTINO"
		search="onFiltrarMatchcode($event, ['Descripcion','IdAlmacen'])"
		confirm="onAgregarValorMatchcodeAlmacenDestino"
		cancel="onCerrarFragmento('AyudaAlmacenesDestino')"
		noDataText="SIN DATOS"
		items="{mAyudaAlmacenesDestino>/}">
		<StandardListItem
			title="{mAyudaAlmacenesDestino>Descripcion}"
			description="{mAyudaAlmacenesDestino>IdAlmacen}"
			iconDensityAware="false"
			iconInset="false"
			type="Active" />
	</SelectDialog>
</core:FragmentDefinition>