<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<SelectDialog
		title="IMPRESORA"
		search="onFiltrarMatchcode($event, ['IdImpresora'])"
		confirm="onAgregarValorMatchcodeImpresora"
		cancel="onCerrarFragmento('AyudaImpresora')"
		noDataText="SIN DATOS"
		items="{mAyudaImpresoras>/}">		
		<StandardListItem
			title="{mAyudaImpresoras>IdImpresora}"
			description="{mAyudaImpresoras>IdImpresora}"
			iconDensityAware="false"
			iconInset="false"
			type="Active" />
	</SelectDialog>
</core:FragmentDefinition>

