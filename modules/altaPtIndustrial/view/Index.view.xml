				<!-- TABLA LISTADO -->
				<FlexBox
					direction="Column"
					height="100%"
					renderType="Bare"
					justifyContent="Inherit"
					alignItems="Center">
					<items>
						<Table id="table-lista_principal_alta_industrial" items="{mListaPrincipal>/}">
							<headerToolbar>
								<OverflowToolbar>
									<content>
										<Title text="Crear HU de Prod. Industrial" level="H2"/>
										<ToolbarSpacer/>
										<Button press="onAbrirRemontarHU" type="Emphasized" text="Remontar"/>
										<Button type="Emphasized" text="Trasladar HU" press="onAbrirTrasladoHU"/>
										<Button press="onAbrirAlmacenarHU" type="Emphasized" text="Almacenar HU EWM"/>
									</content>
								</OverflowToolbar>
							</headerToolbar>
							<columns>
								<Column
									hAlign="Center" vAlign="Middle"
									minScreenWidth="Tablet"
									demandPopin="true">
									<Text text="Guía" />
								</Column>
								<Column
									hAlign="Center" vAlign="Middle"
									minScreenWidth="Tablet"
									demandPopin="true">
									<Text text="Empresa de Agrícola" />
								</Column>
								
								<Column
									hAlign="Center" vAlign="Middle"
									width="12em">
									<Text text="Módulo" />
								</Column>

								<Column
									hAlign="Center" vAlign="Middle"
									minScreenWidth="Tablet"
									demandPopin="true">
									<Text text="Variedad" />
								</Column>

								<Column
									hAlign="Center" vAlign="Middle"
									minScreenWidth="Tablet"
									demandPopin="true">
									<Text text="Lote" />
								</Column>
								
								<Column
									hAlign="Center" vAlign="Middle"
									minScreenWidth="Tablet"
									demandPopin="true">
									<Text text="Cantidad" />
								</Column>
							</columns>
							<items>
								<ColumnListItem type="Navigation" press="onAbrirCrearHU">
									<cells>
										<Text
											text="{mListaPrincipal>Guia}"/>
										<Text
											text="{mListaPrincipal>EmpresaAgricola}"/>
										<Text
											text="{mListaPrincipal>Modulo}"/>
										<Text
											text="{mListaPrincipal>Variedad}"/>
										<Text
											text="{mListaPrincipal>IdLote}"/>
										<Text
											text="{mListaPrincipal>Cantidad}"/>
									</cells>
								</ColumnListItem>								
							</items>
						</Table>
					</items>
				</FlexBox>
			</content>
		</Page>
</mvc:View>