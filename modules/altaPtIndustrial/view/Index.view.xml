<mvc:View 
	controllerName="AvocadoProyecto.AvocadoProyecto.modules.altaPtIndustrial.controller.Index" 
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form">
		<Page title="ALTA DE PRODUCTO INDUSTRIAL" showNavButton="true" class="sapUiStdPage" navButtonPress="onPressInicion">
			<content>

		  <!-- Filtros -->
		  <Panel>
		 <HBox justifyContent="SpaceBetween" alignItems="Center">
			  <VBox>
			  	<Label text="Centro" />
			    <Input 
								id="input-filter_centro"
								editable="false"								
								value="{mFiltros>/IdCentro}"
								change=".ResetFilterInputState"
								class="sapUiSizeCompact"
								required="true"
								showValueHelp="true"
								valueHelpOnly="false"
								valueHelpRequest=".onAbrirMatchcode($event, 'AyudaCentro')"/>
			  </VBox>
			  <VBox>
			  	<Label text="Guía" />
			    	<Input 
								value="{mFiltros>/Guia}"
								change=".ResetFilterInputState"
								class="sapUiSizeCompact"
								showValueHelp="true"
								valueHelpOnly="false"
								valueHelpRequest=".onAbrirMatchcode($event, 'AyudaGuia')"/>
			  </VBox>
			   <VBox>
			  	<Label text="Empresa Agrícola" />
			    	<Input 
								value="{mFiltros>/IdEmpresaAgricola}"
								change=".ResetFilterInputState"
								class="sapUiSizeCompact"
								showValueHelp="true"
								valueHelpOnly="false"
								valueHelpRequest=".onAbrirMatchcode($event, 'AyudaEmpresaAgricola')"/>	
			  </VBox>
			   <VBox>
			  	<Label text="Almacén" />
			    	<Input 
								value="{mFiltros>/IdAlmacen}"
								change=".ResetFilterInputState"
								class="sapUiSizeCompact"
								/>
			  </VBox>
			   <VBox>
			  	<Label text="" />
			  	<Button class="sapUiSizeCompact sapUiSmallMarginBottom" width="30%" type="Emphasized" icon="sap-icon://search" press="onBuscar"></Button>
			    
			  </VBox>
	
			    
			  </HBox>
			</Panel>
	
