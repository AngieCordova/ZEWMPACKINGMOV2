{
	"_version": "1.8.0",
	"sap.app": {
		"id": "AvocadoProyecto.AvocadoProyecto",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"sourceTemplate": {
			"id": "ui5template.basicSAPUI5ApplicationProject",
			"version": "1.40.12",
			"toolsId": "e441db17-eb35-4a06-866d-921a175699fe"
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		},
		"supportedThemes": [
			"sap_hcb",
			"sap_belize"
		]
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "AvocadoProyecto.AvocadoProyecto.view.MenuSplitAvocado",
			"type": "XML"
		},
		"dependencies": {
			"minUI5Version": "1.30.0",
			"libs": {
				"sap.ui.layout": {},
				"sap.ui.core": {},
				"sap.ui.table": {},
				"sap.m": {},
				"sap.tnt": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "AvocadoProyecto.AvocadoProyecto.i18n.i18n"
				}
			}
		},
		"resources": {
			"css": [
				{
					"uri": "css/style.css"
				}
			]
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"viewType": "XML",
				"async": true,
				"viewPath": "AvocadoProyecto.AvocadoProyecto.view",
				"controlAggregation": "pages",
				"controlId": "idAppControl"
			},
			"routes": [
				{
					"name": "RouteView1",
					"pattern": "RouteView1",
					"target": [
						"TargetView1"
					]
				}
			],
			"targets": {
				"TargetView1": {
					"viewType": "XML",
					"transition": "slide",
					"clearAggregation": true,
					"viewName": "View1",
					"viewId": "MenuPrincipal"
				},
				"MenuSplitAvocado": {
					"viewType": "XML",
					"viewName": "MenuSplitAvocado",
					"viewId": "PageMenuSplitAvocadoView"
				}
			}
		},
		"flexBundle": false
	},
	"sap.platform.abap": {
		"uri": "/sap/bc/ui5_ui5/sap/zewmpackingmov/webcontent/webapp",
		"_version": "1.1.0"
	}
}