<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<SelectDialog
		growingThreshold="10"
		cancel="onCerrarFragmento('ModalAyudaUbicacion')"
		confirm="onAgregarUbicacion"
		search="onFiltrarAyuda"
		noDataText="SIN DATOS"
		title="SELECCIONE UBICACIÓN"
		items="{/}" >
		<StandardListItem
			title="{E_LGPLA}"
			description="{E_CANTIDAD}"
			iconDensityAware="false"
			iconInset="false"
			type="Active" />
	</SelectDialog>
</core:FragmentDefinition>